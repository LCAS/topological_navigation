{
	"name": "topological_navigation",
	"dockerComposeFile": "compose.yaml",
	"service": "topo-nav",
	"workspaceFolder": "/workspace/src",
	"updateRemoteUserUID": true,
	
	"forwardPorts": ["vnc:5801"],
	"portsAttributes": {
		"vnc:5801": { "label": "novnc" }
	},	

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"AlessandroSofia.ros2-topic-viewer",
				"ms-vscode.cpptools",
				"redhat.vscode-yaml",
				"twxs.cmake",
				"nonanonno.vscode-ros2",
				"deitry.colcon-helper",
				"yzhang.markdown-all-in-one",
				"github.vscode-github-actions",
				"ArshadKhan.topological-map-visual"
			]
		}
	}
}