<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>topological_navigation_demo_deployment</name>
  <version>0.1.0</version>
  <description>
    Example custom deployment package for topological_navigation.
    Contains deployment-specific BT configs, graph, and Nav2 params.
    Use this as a template for your own robot/environment.
  </description>

  <maintainer email="maintainers@example.com">Topological Navigation Team</maintainer>
  <license>Apache-2.0</license>

  <depend>topological_navigation</depend>
  <depend>topological_navigation_demo</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
